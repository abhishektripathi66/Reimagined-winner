# Copy these settings into .env beside dhan-proxy.js. The backend reads .env
# once when it starts. Restart the backend after changing credentials.
# Secret values stay in Node; the HTML receives configured/not-configured flags
# and masked client IDs only.

# ── AI providers ─────────────────────────────────────────────────────────────
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Google sign-in client ID (public OAuth identifier)
GOOGLE_CLIENT_ID=

# ── Broker chosen for portfolio/order operations ────────────────────────────
# Leave blank to select a configured broker in the UI. Supported: dhan,
# zerodha, groww, upstox, angel.
DEFAULT_BROKER=

# ── Dhan ────────────────────────────────────────────────────────────────────
# Dhan access tokens usually need to be refreshed daily.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ── Upstox ──────────────────────────────────────────────────────────────────
# OAuth app credentials are for token generation; access/Analytics tokens are
# used by the app. The token itself remains on the backend.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_ACCESS_TOKEN=
UPSTOX_ANALYTICS_TOKEN=

# ── Groww ───────────────────────────────────────────────────────────────────
GROWW_CLIENT_ID=
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=

# ── Zerodha Kite ────────────────────────────────────────────────────────────
ZERODHA_CLIENT_ID=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# ── Angel One SmartAPI ──────────────────────────────────────────────────────
ANGELONE_CLIENT_ID=
ANGELONE_API_KEY=
ANGELONE_API_SECRET=
ANGELONE_ACCESS_TOKEN=
ANGELONE_REFRESH_TOKEN=

# ── Other/custom brokers ────────────────────────────────────────────────────
# Flexible credential slots. A broker API adapter must also exist in the
# backend before these values can connect or place orders.
BROKER_1_NAME=
BROKER_1_BASE_URL=
BROKER_1_CLIENT_ID=
BROKER_1_API_KEY=
BROKER_1_API_SECRET=
BROKER_1_ACCESS_TOKEN=
BROKER_1_REFRESH_TOKEN=

BROKER_2_NAME=
BROKER_2_BASE_URL=
BROKER_2_CLIENT_ID=
BROKER_2_API_KEY=
BROKER_2_API_SECRET=
BROKER_2_ACCESS_TOKEN=
BROKER_2_REFRESH_TOKEN=

# ── Local backend ───────────────────────────────────────────────────────────
PORT=8765

# Copy this template to .env beside dhan-proxy.js. Replace only values you use.
# Never commit .env or share screenshots that show its contents.
PORT=8765
AI_PROVIDER=gemini

# AI providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
